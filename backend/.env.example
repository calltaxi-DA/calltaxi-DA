# backend/.env 로 복사해서 사용 (커밋 금지)
APP_ENV=local
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_ENABLE_SAMPLE_ROUTES=false
APP_TMAP_APP_KEY=
# TMAP_APP_KEY= 도 로컬 호환용으로 읽을 수 있지만, 서비스 설정은 APP_TMAP_APP_KEY를 권장한다.
APP_ODSAY_API_KEY=
# ODsay backend 호출용 Server Key를 넣고, 필요한 경우 ODsay 콘솔에 서버 IP를 등록한다.
# ODSAY_API_KEY= 도 로컬 호환용으로 읽을 수 있지만, 서비스 설정은 APP_ODSAY_API_KEY를 권장한다.
