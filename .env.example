# 루트 .env로 복사해서 사용 (커밋 금지)

# Backend 공통 설정
APP_ENV=local
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_ENABLE_SAMPLE_ROUTES=false
# 쉼표로 구분한 Frontend origin allowlist. 배포 시 실제 Frontend origin으로 변경한다.
APP_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TMAP_APP_KEY=
# TMAP_APP_KEY=도 로컬 호환용으로 읽을 수 있지만 APP_TMAP_APP_KEY를 권장한다.
APP_ODSAY_API_KEY=
# ODsay Server Key를 넣고 필요한 경우 ODsay 콘솔에 서버 IP를 등록한다.
# ODSAY_API_KEY=도 로컬 호환용으로 읽을 수 있지만 APP_ODSAY_API_KEY를 권장한다.
# 저장소 루트 기준 교통비 기록 SQLite 경로. 절대경로도 사용할 수 있다.
APP_TRANSPORT_COST_DB_PATH=backend/var/transport_costs.sqlite3

# Kakao Maps JavaScript SDK 앱 키
# 브라우저에 노출되는 지도 SDK용 키만 넣는다.
KAKAO_JS_KEY=

# Frontend가 직접 호출할 Backend URL. 배포 시 실제 Backend URL로 변경한다.
VITE_API_BASE_URL=http://127.0.0.1:8000
