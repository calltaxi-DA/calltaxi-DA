# 루트 .env로 복사해서 사용 (커밋 금지)

# Backend 공통 설정
APP_ENV=local
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_ENABLE_SAMPLE_ROUTES=false
# 쉼표로 구분한 Frontend origin allowlist. 배포 시 실제 Frontend origin으로 변경한다.
APP_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TMAP_APP_KEY=
# TMAP_APP_KEY=도 로컬 호환용으로 읽을 수 있지만 APP_TMAP_APP_KEY를 권장한다.
APP_ODSAY_API_KEY=
# ODsay Server Key를 넣고 필요한 경우 ODsay 콘솔에 서버 IP를 등록한다.
# ODSAY_API_KEY=도 로컬 호환용으로 읽을 수 있지만 APP_ODSAY_API_KEY를 권장한다.
# 장애인 콜택시 대기시간 Prediction serving lookup. 비어 있으면 콜택시 예측은 unavailable 처리된다.
APP_CALLTAXI_OPERATION_COUNT_LOOKUP_PATH=
APP_SEOUL_WEATHER_OBSERVATION_LOOKUP_PATH=
# 장애인 콜택시 대기시간 Prediction 모델 artifact/metadata 경로. 비우면 아래 기본 경로를 사용한다.
# 모델 artifact는 Git LFS 관리 대상이므로 새 환경에서는 git lfs pull 후 runtime check를 실행한다.
APP_WAITING_TIME_MODEL_PATH=analysis/waiting_time/rf_wait_time_v2_prev_day_weather_final.joblib
APP_WAITING_TIME_MODEL_METADATA_PATH=analysis/waiting_time/rf_wait_time_v2_prev_day_weather_final_metadata.json
# 저장소 루트 기준 교통비 기록 SQLite 경로. 절대경로도 사용할 수 있다.
APP_TRANSPORT_COST_DB_PATH=backend/var/transport_costs.sqlite3

# Kakao Maps JavaScript SDK 앱 키
# 브라우저에 노출되는 지도 SDK용 키만 넣는다.
KAKAO_JS_KEY=

# Frontend가 직접 호출할 Backend URL. 배포 시 실제 Backend URL로 변경한다.
VITE_API_BASE_URL=http://127.0.0.1:8000
